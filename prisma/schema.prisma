// Modelo de datos de Operation Manager.
// Los campos de tipo cerrado son String y sus valores válidos viven en src/lib/dominio.ts,
// no enums de base de datos: así agregar una tipología o un estado es un cambio de código y
// no una migración. Los payloads JSON se guardan como texto por la misma razón.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// La URL de conexión vive en prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

model Zona {
  id      String @id @default(cuid())
  nombre  String @unique
  gerente String
  orden   Int    @default(0)

  // Zona Oriente se gestiona tienda por tienda; el resto de la cadena entra como total de zona,
  // porque de esas sucursales solo llega el agregado. Es la línea de comparación.
  detallada Boolean @default(false)

  tiendas   Tienda[]
  registros RegistroZona[]
  planes    PlanAccion[]
  notas     NotaMemoria[]
  perfiles  Perfil[]
}

// Cifras agregadas de una zona que no se gestiona al detalle. Aquí sí se captura el total,
// porque no hay detalle de tienda del cual derivarlo.
model RegistroZona {
  id      String @id @default(cuid())
  corteId String
  zonaId  String
  corte   Corte  @relation(fields: [corteId], references: [id], onDelete: Cascade)
  zona    Zona   @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  ventasMeta        Float?
  ventasReal        Float?
  unidadesMeta      Float?
  unidadesReal      Float?
  transaccionesMeta Float?
  transaccionesReal Float?
  margenBrutoMeta   Float?
  margenBrutoReal   Float?

  origen        String   @default("MANUAL")
  actualizadoEn DateTime @updatedAt

  @@unique([corteId, zonaId])
}

model Tienda {
  id     String  @id @default(cuid())
  nombre String  @unique
  codigo String? @unique
  activa Boolean @default(true)
  orden  Int     @default(0)
  zonaId String
  zona   Zona    @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  // Una misma tienda viaja con distintos nombres según el reporte ("Plaza Mayor" en el comercial,
  // "SUC. LECHERÍA" en el del sistema). Aquí van esos otros nombres, uno por línea, para que la
  // lectura automática la reconozca igual.
  alias String?

  // Atributos para una cadena en crecimiento: fechaApertura permite aislar las tiendas nuevas
  // del comparativo (ventas comparables) y metrosCuadrados habilita productividad por m².
  ciudad          String?
  formato         String?
  metrosCuadrados Float?
  fechaApertura   DateTime?

  // "Ventas Corporativas" viaja como una fila más del informe pero no es una sucursal: es un
  // canal con un ticket cincuenta veces mayor y otro surtido. Suma al total de la cadena y
  // queda fuera de rankings, dispersión y detección de atípicos, donde solo sería ruido.
  comparable Boolean @default(true)

  ventas       RegistroVentas[]
  ajustes      RegistroAjuste[]
  categorias   RegistroCategoria[]
  alertas      Alerta[]
  planes       PlanAccion[]
  notas        NotaMemoria[]
  inspecciones Inspeccion[]
  plantilla    RegistroPlantilla[]
  bajoCosto    ProductoBajoCosto[]

  @@index([zonaId])
}

model Corte {
  id                String   @id @default(cuid())
  nombre            String   @unique
  tipo              String // SEMANAL | CIERRE_MES
  fechaInicio       DateTime
  fechaFin          DateTime
  estado            String   @default("BORRADOR") // BORRADOR | REVISION | CERRADO
  diasDelMes        Int?
  diasTranscurridos Int?
  creadoEn          DateTime @default(now())

  ventas        RegistroVentas[]
  registrosZona RegistroZona[]
  categorias    RegistroCategoria[]
  ajustes       RegistroAjuste[]
  alertas       Alerta[]
  extracciones  Extraccion[]
  planes        PlanAccion[]
  notas         NotaMemoria[]
  analisis      Analisis[]
  inspecciones  Inspeccion[]
  plantilla     RegistroPlantilla[]
  productos     RegistroProducto[]
  bajoCosto     ProductoBajoCosto[]
}

// Lectura del cerebro analítico sobre un corte. Se guarda para no volver a pedirla y para
// poder comparar qué se dijo en un corte contra lo que pasó en el siguiente.
model Analisis {
  id        String  @id @default(cuid())
  corteId   String
  corte     Corte   @relation(fields: [corteId], references: [id], onDelete: Cascade)
  alcance   String  @default("CADENA") // CADENA | ZONA | TIENDA
  zonaId    String?
  tiendaId  String?
  contenido String // JSON del análisis
  modelo    String

  creadoEn DateTime @default(now())

  @@index([corteId, alcance])
}

model RegistroVentas {
  id       String @id @default(cuid())
  corteId  String
  tiendaId String
  corte    Corte  @relation(fields: [corteId], references: [id], onDelete: Cascade)
  tienda   Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  ventasMeta        Float?
  ventasReal        Float?
  unidadesMeta      Float?
  unidadesReal      Float?
  transaccionesMeta Float?
  transaccionesReal Float?
  margenBrutoMeta   Float? // %MB
  margenBrutoReal   Float?

  // Indicadores que el informe ya trae calculados. No se usan para nada más que compararlos
  // con los que deriva la aplicación: si el impreso y el derivado no coinciden, hay algo que
  // entender antes de decidir sobre esa cifra, y eso se levanta como alerta.
  ticketPromedioInforme Float?
  precioPromedioInforme Float?
  unidadesPorTicketInforme Float?

  origen        String   @default("MANUAL") // MANUAL | CSV | IA
  actualizadoEn DateTime @updatedAt

  @@unique([corteId, tiendaId])
  @@index([tiendaId])
}

// Venta diaria de toda la cadena. El Resumen Ejecutivo publica dos tablas de siete días —cada
// día contra el anterior y contra el mismo día de la semana pasada—, pero son dos lecturas de
// una sola serie: se guarda la serie y los dos comparativos se derivan.
model VentaDiaria {
  id     String   @id @default(cuid())
  fecha  DateTime @unique
  ventas Float

  origen        String   @default("IA")
  actualizadoEn DateTime @updatedAt
}

// Productos que una tienda vendió a costo o por debajo en el período, tal como los lista el
// reporte de ventas por categoría. Se guarda por tienda para ver cuándo el mismo producto se
// repite en varias: eso ya no es un problema de la tienda sino un precio mal puesto en la cadena.
model ProductoBajoCosto {
  id       String @id @default(cuid())
  corteId  String
  tiendaId String
  corte    Corte  @relation(fields: [corteId], references: [id], onDelete: Cascade)
  tienda   Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  codigo   String // código de barra o interno, como lo imprime el reporte
  producto String

  origen   String   @default("PDF")
  creadoEn DateTime @default(now())

  @@unique([corteId, tiendaId, codigo])
  @@index([corteId, codigo])
}

// Productos del top de rotación que publica el informe. No es un catálogo maestro: son los que
// el informe destaca, y sirven para ver qué sostiene el volumen y qué entra o sale del top.
model Producto {
  id     String @id @default(cuid())
  nombre String @unique
  // PERECEDERO | NO_PERECEDERO
  familia String

  registros RegistroProducto[]
}

model RegistroProducto {
  id         String   @id @default(cuid())
  corteId    String
  productoId String
  corte      Corte    @relation(fields: [corteId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  unidades Float?
  // Puesto que ocupaba en el top del informe: entrar o salir del top dice tanto como el número.
  posicion Int?

  origen        String   @default("IA")
  actualizadoEn DateTime @updatedAt

  @@unique([corteId, productoId])
  @@index([productoId])
}

model RegistroAjuste {
  id       String @id @default(cuid())
  corteId  String
  tiendaId String
  corte    Corte  @relation(fields: [corteId], references: [id], onDelete: Cascade)
  tienda   Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  // MERMA | MERCANCIA_DANADA | CARGA_DESCARGA | INVENTARIO | ERRORES_VENTA
  tipologia     String
  monto         Float    @default(0)
  porcentaje    Float?
  origen        String   @default("MANUAL")
  actualizadoEn DateTime @updatedAt

  @@unique([corteId, tiendaId, tipologia])
  @@index([tiendaId])
}

// Categorías de venta (Carnicería, Charcutería, …): la dimensión donde se ve de dónde sale el
// margen y qué está drenando el resultado, más allá del total de la tienda.
model Categoria {
  id     String @id @default(cuid())
  nombre String @unique
  orden  Int    @default(0)

  // Cómo la escribe el sistema que emite el informe, uno por línea. Sirve para que la lectura
  // automática reconozca "FRUTO SECOS" como Frutos Secos sin tener que renombrar la categoría.
  alias String?

  registros RegistroCategoria[]
}

model RegistroCategoria {
  id          String    @id @default(cuid())
  corteId     String
  // Nulo cuando la cifra es de toda la cadena: el Resumen Ejecutivo publica la mezcla de
  // categorías consolidada, sin abrirla por sucursal. La ingesta reemplaza el juego completo
  // de filas de cadena en cada carga, que es lo que evita duplicados sin poder apoyarse en el
  // índice único (en Postgres dos NULL no chocan entre sí).
  tiendaId    String?
  categoriaId String
  corte       Corte     @relation(fields: [corteId], references: [id], onDelete: Cascade)
  tienda      Tienda?   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  ventasReal      Float?
  unidadesReal    Float?
  margenBrutoReal Float?

  origen        String   @default("MANUAL")
  actualizadoEn DateTime @updatedAt

  @@unique([corteId, tiendaId, categoriaId])
  @@index([categoriaId])
  @@index([tiendaId])
}

model Alerta {
  id       String  @id @default(cuid())
  corteId  String
  tiendaId String?
  corte    Corte   @relation(fields: [corteId], references: [id], onDelete: Cascade)
  tienda   Tienda? @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  // SUBTOTAL_DESCUADRADO | POSIBLE_INTERCAMBIO | VALOR_ATIPICO | DATO_FALTANTE | SALTO_IMPOSIBLE
  tipo           String
  severidad      String // ALTA | MEDIA | BAJA
  indicador      String?
  valorObservado Float?
  valorEsperado  Float?
  mensaje        String
  estado         String   @default("ABIERTA") // ABIERTA | REVISADA | DESCARTADA
  nota           String?
  creadaEn       DateTime @default(now())

  @@index([corteId, estado])
  @@index([tiendaId])
}

model PlanAccion {
  id       String  @id @default(cuid())
  titulo   String
  alcance  String // CADENA | ZONA | TIENDA
  zonaId   String?
  tiendaId String?
  corteId  String?
  zona     Zona?   @relation(fields: [zonaId], references: [id], onDelete: SetNull)
  tienda   Tienda? @relation(fields: [tiendaId], references: [id], onDelete: SetNull)
  corte    Corte?  @relation(fields: [corteId], references: [id], onDelete: SetNull)

  diagnostico    String?
  oportunidadUsd Float    @default(0)
  estado         String   @default("BORRADOR") // BORRADOR | ACTIVO | CERRADO
  creadoEn       DateTime @default(now())

  metas MetaPlan[]
  hitos HitoPlan[]

  @@index([tiendaId])
  @@index([zonaId])
}

model MetaPlan {
  id            String     @id @default(cuid())
  planId        String
  plan          PlanAccion @relation(fields: [planId], references: [id], onDelete: Cascade)
  indicador     String
  valorActual   Float?
  valorObjetivo Float?
  unidad        String     @default("USD") // USD | UNIDADES | PORCENTAJE

  @@index([planId])
}

model HitoPlan {
  id          String     @id @default(cuid())
  planId      String
  plan        PlanAccion @relation(fields: [planId], references: [id], onDelete: Cascade)
  mes         Int // 1 | 2 | 3
  descripcion String
  responsable String?
  fechaLimite DateTime?
  estado      String     @default("PENDIENTE") // PENDIENTE | EN_CURSO | COMPLETADO

  @@index([planId])
}

// Umbrales del motor de alertas, editables desde la app: lo que hoy es atípico deja de serlo
// cuando la cadena crece, y ajustarlo no debe requerir tocar código.
model Umbral {
  id       String   @id @default(cuid())
  clave    String   @unique
  etiqueta String
  valor    Float
  unidad   String   @default("PORCENTAJE") // PORCENTAJE | USD | FACTOR
  nota     String?
  editado  DateTime @updatedAt
}

// Referencias externas contra las que se mide la operación (NRF, IGD, criterio interno).
// Se cargan desde Configuración: la app no inventa un benchmark que no le hayan dado.
model Benchmark {
  id       String  @id @default(cuid())
  clave    String  @unique
  etiqueta String
  valor    Float?
  unidad   String  @default("PORCENTAJE") // PORCENTAJE | USD | FACTOR
  fuente   String  @default("Interno")
  nota     String?

  editado DateTime @updatedAt
}

// Usuario maestro único: la app se ajusta a su forma de trabajar. Una sola fila, id "maestro".
model Perfil {
  id           String  @id @default("maestro")
  nombre       String
  cargo        String
  zonaPropiaId String?
  zonaPropia   Zona?   @relation(fields: [zonaPropiaId], references: [id], onDelete: SetNull)

  // Identidad de la herramienta: cómo se llama y con qué monograma se firma lo que produce.
  marca     String?
  iniciales String?

  // Contexto del negocio y de su forma de trabajo, en texto libre: alimenta al cerebro analítico.
  contexto             String?
  instruccionesCerebro String?
  preferencias         String? // JSON serializado
  actualizadoEn        DateTime @updatedAt

  @@index([zonaPropiaId])
}

// Memoria operativa: lo que el usuario sabe y la data no dice. Se suma al contexto del análisis.
model NotaMemoria {
  id       String  @id @default(cuid())
  texto    String
  etiqueta String? // OPERACION | PERSONAL | INVENTARIO | COMERCIAL | OTRO
  vigente  Boolean @default(true)

  tiendaId String?
  zonaId   String?
  corteId  String?
  tienda   Tienda? @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  zona     Zona?   @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  corte    Corte?  @relation(fields: [corteId], references: [id], onDelete: SetNull)

  creadaEn DateTime @default(now())

  @@index([tiendaId])
  @@index([zonaId])
}

model Extraccion {
  id      String  @id @default(cuid())
  corteId String?
  corte   Corte?  @relation(fields: [corteId], references: [id], onDelete: SetNull)

  archivoNombre String
  archivoTipo   String

  // El original se guarda en la base y no en disco: en un despliegue serverless el sistema de
  // archivos es de solo lectura y efímero, y el rastro de auditoría se perdería en cada deploy.
  archivoContenido Bytes?
  destino          String   @default("VENTAS") // VENTAS | AJUSTES
  estado           String   @default("PENDIENTE") // PENDIENTE | EXTRAIDO | CONFIRMADO | ERROR
  modelo           String?
  respuestaCruda   String? // JSON serializado
  error            String?
  creadaEn         DateTime @default(now())

  @@index([corteId])
}

// ─── Checklists de operación ────────────────────────────────────────────────
// Lo que se revisa en tienda y qué se hizo con lo que salió mal. Una plantilla se aplica
// muchas veces; cada aplicación es una Inspección y cada punto revisado deja su resultado,
// su observación y su corrección con responsable y fecha. Una corrección sin dueño ni plazo
// no se cierra nunca, así que ambos campos viven en el modelo y no en un texto libre.

model Checklist {
  id          String  @id @default(cuid())
  nombre      String  @unique
  descripcion String?
  // Cada cuánto se espera aplicar: DIARIA | SEMANAL | MENSUAL | EVENTUAL
  frecuencia  String  @default("SEMANAL")
  activa      Boolean @default(true)
  orden       Int     @default(0)

  puntos       PuntoChecklist[]
  inspecciones Inspeccion[]
}

model PuntoChecklist {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  actividad String
  // Agrupa los puntos dentro de la hoja: Salón, Perecederos, Almacén, Caja, Personal…
  area      String?
  // Un punto crítico que sale NO OK no se puede cerrar la inspección sin corrección.
  critico   Boolean @default(false)
  orden     Int     @default(0)

  resultados ResultadoPunto[]

  @@index([checklistId])
}

model Inspeccion {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  tiendaId    String
  tienda      Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  corteId     String?
  corte       Corte?    @relation(fields: [corteId], references: [id], onDelete: SetNull)

  fecha       DateTime @default(now())
  responsable String?
  // ABIERTA mientras se llena; CERRADA cuando se dio por revisada.
  estado      String   @default("ABIERTA")
  nota        String?
  creadaEn    DateTime @default(now())

  resultados ResultadoPunto[]

  @@index([tiendaId, fecha])
  @@index([checklistId])
}

model ResultadoPunto {
  id           String         @id @default(cuid())
  inspeccionId String
  inspeccion   Inspeccion     @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  puntoId      String
  punto        PuntoChecklist @relation(fields: [puntoId], references: [id], onDelete: Cascade)

  // PENDIENTE mientras no se ha revisado; luego OK | NO_OK | NO_APLICA.
  cumple      String    @default("PENDIENTE")
  // Qué se encontró mal. Solo tiene sentido cuando cumple = NO_OK.
  observacion String?
  // El plan de acción: qué se va a hacer, quién y para cuándo.
  correccion  String?
  responsable String?
  fechaLimite DateTime?
  // PENDIENTE | EN_CURSO | RESUELTO | VERIFICADO
  estado      String    @default("PENDIENTE")

  actualizadoEn DateTime @updatedAt

  @@unique([inspeccionId, puntoId])
  @@index([puntoId])
  @@index([estado])
}

// ─── Eficiencia de la plantilla ──────────────────────────────────────────────
// Cuánto produce cada hora de trabajo pagada. El KPI depende del área: las de venta directa
// se miden en ventas por hora, las de reposición en unidades por hora, las de atención en
// transacciones por hora, y las que no tienen volumen propio (limpieza, seguridad) solo por
// cobertura de plantilla. El estándar internacional llega como rango, no como punto: guardar
// solo el punto medio convertiría en desviación lo que es dispersión normal de la industria.

model AreaOperativa {
  id     String @id @default(cuid())
  nombre String @unique

  // SPLH | UPLH | TPLH | COBERTURA
  kpi String

  // Rango de referencia y el punto contra el que se calcula el índice. Dentro del rango el
  // área cumple; el punto solo sirve para ordenar qué tan lejos está la que se sale.
  estandarMin Float?
  estandarMax Float?
  estandar    Float?

  fuente String?
  nota   String?

  // Administración se mide contra la venta de toda la tienda, no contra una venta propia.
  // Su volumen se deriva del resto y no entra en el total: si se capturara, lo duplicaría.
  usaVentaTienda Boolean @default(false)

  activa Boolean @default(true)
  orden  Int     @default(0)

  registros RegistroPlantilla[]
}

// Lo que se captura de un área en un corte. Todo lo demás —productividad, cobertura,
// índice, semáforo, horas ganadas— se deriva en src/lib/plantilla.ts y no se guarda.
model RegistroPlantilla {
  id       String        @id @default(cuid())
  corteId  String
  tiendaId String
  areaId   String
  corte    Corte         @relation(fields: [corteId], references: [id], onDelete: Cascade)
  tienda   Tienda        @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  area     AreaOperativa @relation(fields: [areaId], references: [id], onDelete: Cascade)

  plantillaMeta   Float?
  plantillaActiva Float?

  horasProgramadas Float?
  horasTrabajadas  Float?
  horasAusentismo  Float?
  horasExtra       Float?

  ventas        Float?
  unidades      Float?
  transacciones Float?

  costoNomina Float?

  origen        String   @default("MANUAL")
  actualizadoEn DateTime @updatedAt

  @@unique([corteId, tiendaId, areaId])
  @@index([tiendaId])
  @@index([areaId])
}
