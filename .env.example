# Base de datos PostgreSQL. En local puede ser un Postgres propio; en la nube, el que
# entregue el proveedor (Neon, Supabase, Railway…).
DATABASE_URL="postgresql://usuario:clave@localhost:5432/operation_manager"

# Opcional. Si el proveedor da una cadena con pool y otra directa, pon la directa aquí: las
# migraciones necesitan conexión directa. Con un Postgres propio, déjala vacía.
DIRECT_URL=""

# Acceso a la aplicación. Genera ambos con: npm run auth:hash -- "tu contraseña"
APP_PASSWORD_HASH=""
SESSION_SECRET=""

# Requerida solo para la extracción de PDF/imagen con IA y el análisis del corte
ANTHROPIC_API_KEY=""
