# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# archivos cargados
/uploads

# bases locales sueltas (la aplicación usa PostgreSQL)
*.db
*.db-journal

# cliente Prisma generado (se regenera con `npx prisma generate`)
/src/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
